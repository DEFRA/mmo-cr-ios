//
//  Release.xcconfig
//  record-catch
//
//  Build-time configuration for the Release build configuration (see ADR-0018 and
//  .github/instructions/ci-cd.instructions.md's frozen "Option B" build-time configuration
//  decision). Do NOT put secrets/tokens in this file — it is committed to source control.
//

// Placeholder production HTTPS endpoint, pending the real production reference-data API. Must
// always be `https://` — `APIConfiguration` refuses any non-HTTPS base URL outside of a DEBUG
// build as defence-in-depth (see ADR-0018 §3).
API_BASE_URL = https:$()/$()/reference-data.example.invalid

// ⚠️ TEMPORARY — SECURITY-RELEVANT, REMOVE BEFORE APP STORE SUBMISSION.
// This flag intentionally makes the Settings screen's "DEBUG BUILD ONLY — REMOVE BEFORE RELEASE"
// species-fetch tool compile into a Release-configuration build (which an Xcode Archive always
// uses), purely so it can be verified in an internal TestFlight build. Per
// security.instructions.md ("no debug backdoors in release builds") this line — and the
// `#if DEBUG || ENABLE_DEBUG_REFERENCE_DATA_TOOL` code it gates in SettingsViewModel.swift /
// SettingsView.swift / AuthTokenProviding.swift — MUST be removed before any build destined for
// App Store review/release. Track removal alongside the production-environment ADR work
// (ci-cd.instructions.md "Configuration strategy") once the real prod/test/dev split lands.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) ENABLE_DEBUG_REFERENCE_DATA_TOOL
