default_platform(:ios)

PROJECT = "record-catch.xcodeproj".freeze
SCHEME = "record-catch".freeze
SIMULATOR = "iPhone 17".freeze

platform :ios do
  desc "Compile the app and test bundle without running tests — the CI compile gate."
  lane :build do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [SIMULATOR],
      build_for_testing: true,
      skip_testing: ["record-catchUITests"],
      derived_data_path: "DerivedData"
    )
  end

  desc "Build and run the unit tests with code coverage (used by CI). UI tests are excluded for now."
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [SIMULATOR],
      skip_testing: ["record-catchUITests"],
      code_coverage: true,
      result_bundle: true,
      output_directory: "fastlane/test_output",
      derived_data_path: "DerivedData"
    )
  end

  desc "Build, sign and upload the DEV app to its internal TestFlight group."
  lane :release_dev do
    build_and_upload(
      app_identifier: "mmo.catchrecordingdev.ios",
      # Dev build configuration. The per-environment .xcconfig split is a follow-up owned by the iOS Developer.
      configuration: "Release"
    )
  end

  desc "Distribute the latest uploaded DEV build to external tester groups on TestFlight."
  lane :distribute_dev_external do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    external_groups = ENV.fetch("ASC_EXTERNAL_TESTING_GROUPS", "")
                         .split(",")
                         .map(&:strip)
                         .reject(&:empty?)

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "mmo.catchrecordingdev.ios",
      distribute_only: true,
      distribute_external: true,
      groups: external_groups,
      notify_external_testers: true,
      skip_waiting_for_build_processing: false
    )
  end

  # Parametrised so the future test/prod release lanes reuse the same signed-build-and-upload flow.
  private_lane :build_and_upload do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )

    # POC (DEV): manual .p12 signing — Fastlane Match is bypassed (see docs/adr/0011-release-pipeline.md).
    # The signing certificate and provisioning profile are imported into a temporary keychain by the
    # release workflow before this lane runs. Match remains the target for the full test/prod rollout.
    # match(
    #   type: "appstore",
    #   app_identifier: options[:app_identifier],
    #   readonly: true,
    #   api_key: api_key
    # )

    # Version overrides: only set xcargs when explicit environment variables are provided
    # (e.g. via manual workflow_dispatch). Otherwise, use project.pbxproj build settings directly.
    xcargs = [
      "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY=\"Apple Distribution\"",
      "PROVISIONING_PROFILE_SPECIFIER=\"#{ENV.fetch('PROVISIONING_PROFILE_NAME')}\""
    ]

    project_version = ENV["CURRENT_PROJECT_VERSION"].to_s.strip
    xcargs << "CURRENT_PROJECT_VERSION=#{project_version}" unless project_version.empty?

    marketing_version = ENV["MARKETING_VERSION"].to_s.strip
    xcargs << "MARKETING_VERSION=#{marketing_version}" unless marketing_version.empty?

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: options[:configuration],
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: xcargs.join(" "),
      export_options: {
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          options[:app_identifier] => ENV.fetch("PROVISIONING_PROFILE_NAME")
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: options[:app_identifier],
      distribute_external: false,
      skip_waiting_for_build_processing: true
    )
  end
end
