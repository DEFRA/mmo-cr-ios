    "appLock.unlockReason": {
      "comment": "Reason string passed to the system biometric prompt (LAContext) when re-entering the app (ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mewngofnodwch yn ôl i'ch cofnodion dalfa"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign back in to your catch records"
          }
        }
      }
    },
    "catchRecord.addAnotherPort": {
