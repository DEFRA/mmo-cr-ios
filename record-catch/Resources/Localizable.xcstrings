    "%@ %@": {
      "comment": "A label that reads \"Error: ...\" followed by a localized error message.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "A1234520260727150815": {},
    "Add Item": {
      "comment": "A button that adds a new item.",
      "isCommentAutoGenerated": true
    },
    "Complete required fields first": {
      "comment": "A hint that appears when a button is disabled.",
      "isCommentAutoGenerated": true
    },
    "Hides additional information": {
      "comment": "A hint for the accessibility hint of the button.",
      "isCommentAutoGenerated": true
    },
    "Item at %@": {
      "comment": "A row in a list that shows the date and time of an item.",
      "isCommentAutoGenerated": true
    },
    "Ready to continue": {
      "comment": "A message displayed when the user has filled out the trip form correctly.",
      "isCommentAutoGenerated": true
    },
    "Reveals additional information": {
      "comment": "A hint for a button that expands a section.",
      "isCommentAutoGenerated": true
    },
    "Saves and continues": {
      "comment": "A hint that describes the purpose of a button.",
      "isCommentAutoGenerated": true
    },
    "Select an item": {
      "comment": "A label displayed in the detail view of the `ContentView`.",
      "isCommentAutoGenerated": true
    },
    "Select whether your trip started and finished today": {
      "comment": "A hint displayed under the radio buttons for the user to select whether their trip started and finished today.",
      "isCommentAutoGenerated": true
    },
    "Subzone: %@": {
      "comment": "A label displaying the currently selected subzone on the map. The argument is the name of the selected subzone.",
      "isCommentAutoGenerated": true
    },
    "a11y.errorPrefix": {
      "comment": "Hidden prefix read by VoiceOver before an error message.",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Gwall:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error:"
          }
        }
      }
    },
    "appLock.error.authenticationFailed": {
      "comment": "Perceivable (text+icon) failure message on the app-lock screen when a biometric attempt fails but retrying may help (ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ni allem wirio mai chi ydyw. Rhowch gynnig arall arni, neu mewngofnodwch gyda'ch cyfrinair yn lle hynny."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not verify it's you. Try again, or sign in with your password instead."
          }
        }
      }
    },
    "appLock.error.biometryLockedOut": {
      "comment": "Shown briefly before falling back to the sign-in form after too many failed biometric attempts locked biometrics on this device (ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mae Face ID/Touch ID wedi'i gloi dros dro ar y ddyfais hon. Mewngofnodwch gyda'ch cyfrinair."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID/Touch ID is temporarily locked on this device. Sign in with your password."
          }
        }
      }
    },
    "appLock.error.biometryUnavailable": {
      "comment": "Shown briefly before falling back to the sign-in form when biometrics are not available/enrolled on this device (ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nid yw Face ID/Touch ID ar gael ar y ddyfais hon. Mewngofnodwch gyda'ch cyfrinair."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID/Touch ID is not available on this device. Sign in with your password."
          }
        }
      }
    },
    "appLock.error.cancelled": {
      "comment": "Shown on the app-lock screen after the user cancels a biometric prompt (ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cafodd mewngofnodi ei ganslo. Rhowch gynnig arall arni, neu mewngofnodwch gyda'ch cyfrinair yn lle hynny."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in was cancelled. Try again, or sign in with your password instead."
          }
        }
      }
    },
    "appLock.faceID.scanHint": {
      "comment": "Hint shown above the unlock button only on Face ID devices, since Face ID scans immediately with no explicit start step (Apple HIG; ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bydd Face ID yn sganio'n awtomatig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID will scan automatically"
          }
        }
      }
    },
    "appLock.fallback.link": {
      "comment": "Always-visible manual fallback link on the app-lock screen, so the user is never dead-ended by a failed/unavailable biometric check (ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mewngofnodwch gyda'ch cyfrinair yn lle hynny"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with your password instead"
          }
        }
      }
    },
    "appLock.heading": {
      "comment": "Heading on the offline biometric local re-entry (\"app lock\") screen (ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Croeso'n ôl"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back"
          }
        }
      }
    },
    "appLock.unlock.faceID": {
      "comment": "Primary button title on the app-lock screen when Face ID is available (ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Datgloi gyda Face ID"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock with Face ID"
          }
        }
      }
    },
    "appLock.unlock.generic": {
      "comment": "Primary button title on the app-lock screen when the specific biometry kind is unknown (fallback copy; ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Datgloi"
          }
        },
