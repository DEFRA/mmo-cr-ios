          "stringUnit": {
            "state": "translated",
            "value": "Unlock"
          }
        }
      }
    },
    "appLock.unlock.touchID": {
      "comment": "Primary button title on the app-lock screen when Touch ID is available (ADR-0009).",
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Datgloi gyda Touch ID"
